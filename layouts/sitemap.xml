{{- $pages := slice site.Home -}}
{{- $pages = $pages | append (where site.RegularPages "Section" "post") -}}
{{- with site.GetPage "/page/archives" -}}
  {{- $pages = $pages | append . -}}
{{- end -}}
{{- with site.GetPage "/resume" -}}
  {{- $pages = $pages | append . -}}
{{- end -}}
{{- $pages = where $pages "Sitemap.Disable" "ne" true -}}
{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range $pages }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>
  </url>
{{- end }}
</urlset>
